# Supabase 프로젝트의 Connect 또는 API Keys 화면에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" 로 생성합니다.
INTERVIEW_SESSION_SECRET=
# 선택: 외부 공고 gzip 경로. 생략하면 앱에 포함된 실제 공고 풀을 읽습니다.
# JOBS_POOL_PATH=

# 면접당 양측 에이전트 발화 수 합계. 최종 평가 호출은 별도다.
MAX_TURNS=20
